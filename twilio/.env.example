# Twilio AI Agent - Variables de entorno

# Claude API Key (obtenerla de: https://console.anthropic.com/)
ANTHROPIC_API_KEY=tu_api_key_aqui

# Puerto del servidor
PORT=3000

# ============================================
# Servicios de Speech-to-Text (elegir uno)
# ============================================

# Opción 1: Deepgram (Recomendado - baja latencia)
# https://deepgram.com/
DEEPGRAM_API_KEY=

# Opción 2: AssemblyAI
# https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# Opción 3: Google Cloud Speech-to-Text
# https://cloud.google.com/speech-to-text
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================
# Servicios de Text-to-Speech (elegir uno)
# ============================================

# Opción 1: ElevenLabs (Recomendado - calidad y latencia)
# https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Opción 2: Google Cloud Text-to-Speech
GOOGLE_APPLICATION_CREDENTIALS=

# Opción 3: Amazon Polly
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
